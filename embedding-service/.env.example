EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8091
EMBEDDING_MODEL_SOURCE=BAAI/bge-m3
EMBEDDING_MODEL_NAME=bge-m3
# auto, cpu, cuda or cuda:0
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_DIR=.cache/models
# Pin a model revision/commit when building a persistent vector index.
EMBEDDING_MODEL_REVISION=
# Empty allows local development without a key.
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUTS=32
EMBEDDING_MAX_INPUT_TOKENS=512
EMBEDDING_MAX_INPUT_CHARS=32768
EMBEDDING_MAX_TOTAL_CHARS=131072
EMBEDDING_MAX_BODY_BYTES=1048576
